---
const {content} = Astro.props;
---

<section class="qna-block">
    {
        content.map((item: any) => {
            <div>
                <div class="qna-block__question-area">
                    <p>{item.question}</p>
                </div>
                <div class="qna-block__answer-area">
                    <p>{item.answer}</p>
                </div>
            </div>
        })
    }
</section>