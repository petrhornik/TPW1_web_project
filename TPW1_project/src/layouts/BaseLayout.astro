---
// import koponent
import Header from "../components/core/Header.astro";
import Footer from "../components/core/Footer.astro";

import "../styles/global.css"
import "../styles/header.css"
import "../styles/footer.css"
import "../styles/itemGrid.css"
import "../styles/imageGallery.css"
 
// import proměnných z wrapper tagu
const {pageTitle} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{pageTitle}</title>

    <!-- import fontů -->

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Average+Sans&family=Cambay:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">

</head>
<body>
    <Header />
    <main>
        <slot />
    </main>
    <Footer />
</body>
</html>