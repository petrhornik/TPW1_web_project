---
import BaseLayout from "../../layouts/BaseLayout.astro"
import handbookData from "../../data/linuxHandbook.json"


export const getStaticPaths = (() => {
    return new Array(...handbookData.map(item => {
        return {params: {group: item.id}}
    }))
})

const {group} = Astro.params;

const groupData = handbookData.find(item => {
    return item.id === group && item;
})


---

<BaseLayout>
    <section class="page-content">
        <section class="page-introduction">
            <h2>{groupData.name ? groupData.name : "Stránka nenalezena"}</h2>
        </section>
        <section class="page-content-main page-content-main--row">
            <aside class="">

            </aside>
            <section class="content-box">

            </section>
        </section>
    </section>
</BaseLayout>