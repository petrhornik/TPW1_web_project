---

import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/card.astro";

import distroList from "../../data/distroList.json"

---

<BaseLayout>
    <h2>Dle preference ušito na míru!</h2>
    <hr>
    <section class="item-grid">
        {distroList.distros.map((distro: any, idx) => {
            return(
                <Card
                    imageSrc = {`/images/distros/${distro.id}/logo.svg`} 
                    title = {distro.name}
                    srcLink = {`/distros/${distro.id}`}
                >
                    <Fragment slot="texts">
                        <p><strong>Jednoduchost:</strong> {distro.beginner_friendly_rating}/5</p>
                        <p><strong>Země:</strong> {distro.country_origin}</p>
                    </Fragment>
                </Card>
            )
        })}
    </section>
</BaseLayout>