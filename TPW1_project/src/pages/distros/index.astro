---

import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/card.astro";

import distroList from "../../data/distroList.json"

---

<BaseLayout>
    <main class="page-content">
    <section class="page-introduction">
        <h2>Doporučené distribuce</h2>
        <p>Každý preferuje něco trochu jiného, proto jme pro vás připravili přehled těch nejpopulárnějších distribucí různých drůhů. Pro začátek opravdu doporučujeme vybrat něco z tohoto listu.</p>
    </section>
    <section class="item-grid">
        {distroList.distros.map((distro: any, idx) => {
            return(
                <Card
                    imageSrc = {`/images/distros/${distro.id}/logo.svg`} 
                    title = {distro.name}
                    srcLink = {`/distros/${distro.id}`}
                >
                    <Fragment slot="texts">
                        <p><strong>Jednoduchost:</strong> {distro.beginner_friendly_rating}/5</p>
                        <p><strong>Země:</strong> {distro.country_origin}</p>
                    </Fragment>
                </Card>
            )
        })}
    </section>
    </main>
</BaseLayout>