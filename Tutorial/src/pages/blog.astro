---

// importy jinných komponent/souborů

import "../styles/global.css"       // klasicky ES6 importy
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPost from "../components/BlogPost.astro";

// import objektů pro všechny položky v /posts

const allPosts = Object.values(import.meta.glob("./posts/*.md", {eager: true}));

const pageTitle = "Blog stránky Astro";

---

<BaseLayout pageTitle={pageTitle}>
	<h1>Stránka Blogu</h1>
    <hr>
    {
        allPosts.map((post: any) => {
            return <BlogPost url={post.url} title={post.frontmatter.title} author={post.frontmatter.author} />;
        })
    }
</BaseLayout>
