---

// importy jinných komponent/souborů

import "../styles/global.css"       // klasicky ES6 importy
import Header from "../components/Header.astro"; // import opakovavě použitelné komponenty z /components (podobné jako v Nextu...)
import Footer from "../components/Footer.astro";

const {pageTitle} = Astro.props; // použiju klasický deconstruct proměnných z JS objektu Astro.props

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
	</head>
	<Header />
	<body>
		<h1>{pageTitle}</h1>
        <slot />                <!-- slot určuje místo kam se vloží celý kontent okolo kterého je layout wrapnutý (similar to React) -->
		<Footer />
		<script>
    		import "../scripts/menu.js";	// skripty můzu importovat tímto způvobem (vždycky až za HTML!!)
  		</script>
	</body>
</html>